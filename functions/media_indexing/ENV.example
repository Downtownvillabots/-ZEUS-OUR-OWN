# 🏙️ DOWNTOWN VILLA — MEDIA INDEXING

# Database 1 = core bot database
DATABASE_1_URI=mongodb+srv://YOUR_CORE_DATABASE_URI

# Database 2+ = media databases, comma-separated
MEDIA_DATABASE_URIS=mongodb+srv://YOUR_MEDIA_DB_2,mongodb+srv://YOUR_MEDIA_DB_3

# Telegram channels used for live/database indexing
DATABASE_CHANNELS=-1000000000000,-1000000000001

LIVE_INDEXING_ENABLED=true
HISTORICAL_INDEXING_ENABLED=true

# Rotate before the 512 MB target is reached
MEDIA_DATABASE_ROTATION_MB=400

INDEX_BATCH_SIZE=200
INDEX_MAX_CONCURRENCY=20
INDEX_PROGRESS_EVERY=100
INDEX_MAX_SCAN_MESSAGES=1000000
MAX_DUPLICATE_CANDIDATES=100
